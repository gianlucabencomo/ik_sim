<mujoco model="cobot scene">
  <include file="cobot.xml"/>

  <statistic center="0.1 0 0.15" extent="0.4" meansize="0.03"/>

  <visual>
    <headlight diffuse="0.6 0.6 0.6" ambient="0.1 0.1 0.1" specular="0 0 0"/>
    <global azimuth="120" elevation="-20"/>
  </visual>

  <asset>
    <texture name="grid" type="2d" builtin="checker" rgb1=".2 .3 .4" rgb2=".1 0.15 0.2"
      width="512" height="512" mark="cross" markrgb=".8 .8 .8"/>
    <material name="grid" texture="grid" texrepeat="1 1" texuniform="true"/>

    <texture name="apriltag" type="2d" file="../assets/april_tag.png"/>
    <material name="apriltag" texture="apriltag" texrepeat="1 1" texuniform="false"
      specular="0" shininess="0"/>
  </asset>

  <worldbody>
    <light pos="0 0 1.0" directional="true"/>
    <geom name="floor" size="0.5 0.5 0.01" type="plane" material="grid" contype="2" conaffinity="1"/>
    <geom name="box" pos="0.2 0 0.025" type="box" size="0.1 0.1 0.025" rgba="0.5 0.5 0.5 1"  contype="2" conaffinity="1"/>

    <body name="target" pos="0.15 0 0.2" quat="0 1 0 0" mocap="true">
      <geom type="box" size=".015 .015 .015" contype="0" conaffinity="0" rgba=".6 .3 .3 .5"/>
      <site type="sphere" size="0.005" rgba="0 0 1 1" group="1"/>
    </body>

    <body name="look_at" pos="0.4 0.0 0.2" euler="1.571 -1.571 0">
      <geom name="tag_board" type="plane" size="0.2 0.2 .01"
            material="apriltag" contype="2" conaffinity="1"/>
      <site name="tag_center" pos="0.1 0.1 0.0" type="sphere" size="0.01" rgba="0 0 1 1" group="2"/>
      <site name="tag_up_right" pos="0.1 0.1 0.0" type="sphere" size="0.01" rgba="0 0 1 1" group="2"/>
      <site name="tag_up_left" pos="-0.1 0.1 0.0" type="sphere" size="0.01" rgba="0 0 1 1" group="2"/>
      <site name="tag_down_right" pos="0.1 -0.1 0.0" type="sphere" size="0.01" rgba="0 0 1 1" group="2"/>
      <site name="tag_down_left" pos="-0.1 -0.1 0.0" type="sphere" size="0.01" rgba="0 0 1 1" group="2"/>
    </body>
  </worldbody>
</mujoco>